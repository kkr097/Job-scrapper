{
    "min_score": 5,
    "groq_wait_seconds": 100,
    "rating_preferred": "gemini",
    "scrape_test_mode": true,
    "sources": {
        "linkedin": true,
        "arbeitnow": true,
        "simplyhired": false,
        "company_careers": false
    },
    "score_pending_file": "score_pending_jobs.csv",
    "scoring_window_start": "01:00",
    "scoring_window_end": "07:00",
    "scoring_max_per_day": 40,
    "scoring_cooldown_seconds": 300,
    "scoring_daily_log": "scoring_daily_log.json",
    "linkedin_search_url": "https://www.linkedin.com/jobs/search?keywords=Embedded%20Software&location=Ingolstadt&geoId=102702675&distance=50&f_TPR=r604800&position=1&pageNum=0",
    "linkedin_search_urls": [],
    "linkedin_max_pages": 2,
    "linkedin_fetch_all": true,
    "linkedin_scroll_step": 10,
    "linkedin_page_size": 25,
    "linkedin_delay_min": 12,
    "linkedin_delay_max": 25,
    "linkedin_card_delay_min": 1.2,
    "linkedin_card_delay_max": 2.8,
    "linkedin_use_playwright": false,
    "linkedin_user_agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 Chrome/120.0.0.0 Safari/537.36 Edg/120.0.0.0",
    "linkedin_print_links": true,
    "output": {
        "excel_file": "daily_jobs.csv"
    },
    "output_nonmatch_file": "daily_jobs_nonmatch.csv",
    "cache_file": "seen_jobs_cache.json",
    "cache_days": 45
}
